coverage/

# Variáveis de ambiente (podem conter senhas e chaves)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache de ferramentas
.cache/
.vite/
*.tsbuildinfo
.eslintcache

# Editores e IDEs (mantém só as configs compartilháveis do VS Code)
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Arquivos do sistema operacional
.DS_Store
Thumbs.db